{
  "name": "undercity",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "UNDERCITY: 3D open-world empire game built with Glitch Game Engine.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.undercity.game",
    "productName": "UNDERCITY",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
